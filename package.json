{
  "name": "ipam-aws",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud IP Address Management app for AWS/Azure allocations",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web",
    "packages/infra",
    "packages/importer"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/shared && npm run build --workspace packages/api && npm run build --workspace packages/web",
    "build:shared": "npm run build --workspace packages/shared",
    "build:api": "npm run build --workspace packages/api",
    "build:web": "npm run build --workspace packages/web",
    "build:infra": "npm run build --workspace packages/infra",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
