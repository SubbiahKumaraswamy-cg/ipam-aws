# Copy to .env.local for local development. In production these values are
# written into the built bundle by the deployment pipeline (see docs/DEPLOY.md).

# Base URL of the deployed HTTP API, without a trailing slash.
VITE_API_BASE_URL=https://abc123.execute-api.eu-west-1.amazonaws.com

# Cognito hosted UI / OIDC settings.
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://ipam-xxxxxxxx.auth.eu-west-1.amazoncognito.com
VITE_REDIRECT_URI=http://localhost:5173
VITE_LOGOUT_URI=http://localhost:5173
